# Copy this file to .env (gitignored) and set your own values. docker compose reads .env automatically.
# Folder with the video store generated by tooling/videoGrabber (.mp4 / .webp / .json per video).
PROTUBE_STORE_DIR=C:/path/to/protube-videos
# Optional: OAuth client id for "Sign in with Google" (see DEVELOPMENT.md). Empty hides the Google button.
ENV_PROTUBE_GOOGLE_CLIENT_ID=
